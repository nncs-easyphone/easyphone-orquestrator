# ==============================
# Orquestrator - Environment Variables
# ==============================
# Copiado automaticamente pelo init.sh na primeira execução.
# Valores marcados com ⚠  são críticos de segurança — altere para senhas fortes.

# ---------- Global ----------
DOMAIN=exemplo.com
LETSENCRYPT_EMAIL=admin@exemplo.com
# Porta de gestão (SSH) liberada no firewall — inclusive no boot. O sshd
# TAMBÉM precisa escutar nesta porta, senão o acesso administrativo é perdido.
SSH_PORT=22
# USE_BUILD=true  → build local (./run.sh)
# USE_BUILD=false → pull das imagens do registry (./run.sh)
USE_BUILD=false
# Servidores DNS do container Traefik (resolução externa). Não afeta a
# resolução de nomes de serviço do Docker. Defaults no compose: 8.8.8.8 / 1.1.1.1.
DNS_SERVER_1=8.8.8.8
DNS_SERVER_2=1.1.1.1

# ---------- Postgres ----------
POSTGRES_USER=easyphone
# ⚠ Altere a senha abaixo. Use só letras, números, ponto, hífen e underline —
# evite '+', ':', '@', '/', '#', '%', '$' e espaços (quebram ODBC, URL e .env).
POSTGRES_PASSWORD=easyphone
POSTGRES_DB=easyphone

# ---------- API ----------
NODE_ENV=production
# ⚠ Altere o JWT_SECRET e DATA_SECRET_CRYPTOGRAPHY_KEY
JWT_SECRET=easyphone-jwt-secret
DATA_SECRET_CRYPTOGRAPHY_KEY=easyphone-crypto-key-32bytes!
MAX_CAPTURE_GROUPS=64
ASTERISK_DIALPLAN_ORIGINATE_CONTEXT=CAT_FULL
ASTERISK_DIALPLAN_BLOCK_CONTEXT=CAT_BLOCK

# ---------- Firebase ----------
# ⚠ Substitua pelo JSON real da sua conta de serviço (em linha única)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"123","private_key_id":"123","private_key":"123","client_email":"123","client_id":"123","auth_uri":"123","token_uri":"123","auth_provider_x509_cert_url":"123","client_x509_cert_url":"123","universe_domain":"123"}
# URL base das Cloud Functions. As funções são endereçadas pelo NOME
# (`<base>/assistAgentScript`), sem o rewrite do Firebase Hosting.
# Valor de `firebase functions:list` (coluna URI).
FIREBASE_URL=https://us-central1-easyfone-bc601.cloudfunctions.net

# ---------- Paths (montagens de volume) ----------
ASTERISK_PATH_MOH=/var/lib/asterisk/moh
ASTERISK_PATH_URA=/var/lib/asterisk/sounds/ura
ASTERISK_PATH_CONFIG=/etc/asterisk
ASTERISK_PATH_MONITOR=/var/spool/asterisk/monitor

# ---------- Uploads ----------
UPLOAD_MOH_FORMAT=mp3
UPLOAD_MOH_MAX_FILES=5
UPLOAD_MOH_MAX_FILE_SIZE=8097152
UPLOAD_IVR_MAX_FILE_SIZE=2097152

# ---------- Coturn (STUN/TURN) ----------
# Credencial long-term usada pelos clientes WebRTC (softphone desktop).
# Deve casar com VITE_TURN_USER / VITE_TURN_PASS do easyvoice-desktop.
COTURN_USER=easyphone
# ⚠ Altere a senha abaixo. Use só letras, números, ponto, hífen e underline.
COTURN_PASS=easyphone
# IP público da VM, anunciado nos candidatos ICE. Vazio = autodetecção da
# imagem (--external-ip=$(detect-external-ip)). Preencha se a VM estiver atrás
# de NAT 1:1 ou se a autodetecção não acertar o IP.
COTURN_EXTERNAL_IP=

# STUN consultado pelo Asterisk (rtp.conf stunaddr) para descobrir o próprio
# endereço externo. Vazio (recomendado com IP público direto na interface) =
# a diretiva é removida. Um stunaddr sem resposta bloqueia ~3-8s a criação de
# cada instância RTP — atrasa TODA chamada. Nunca use 127.0.0.1.
ASTERISK_STUN_ADDR=

# Interface em que o ARI do Asterisk (8088) escuta. Vazio = 172.17.0.1, o IP do
# host na bridge docker0 (host.docker.internal, por onde api e seed chegam), que
# é o padrão de toda instalação. Só preencha se o Docker usar outro `bip`
# (confira com `ip -4 addr show docker0`) ou se precisar do ARI de fora do host
# (0.0.0.0). Endereço inexistente cai para 0.0.0.0 com aviso no log do Asterisk.
ASTERISK_HTTP_BIND_ADDR=

# ---------- License ----------
# Client ID da licença no Firebase (opcional — se vazio, status retorna 'blocked')
LICENSE_CLIENT_ID=default-testing-client-id
LICENSE_HARDWARE_ID=

# ---------- Corporate Integration (Matriz ↔ Filial) ----------
# Chave para autorizar requests recebidas (matriz). Se não definida, o endpoint
# PUT /integration/corporate/ivr-unanswered-calls retorna 401.
CORPORATE_ALLOW_API_KEY=

# Chave enviada nas requests da unidade para a matriz.
CORPORATE_API_KEY=

# ---------- Health Check das URAs (lido pelo Zabbix) ----------
# Chave que o Zabbix apresenta no header `x-api-key` para consultar
# GET /monitoring/ivr-health-check. Se não definida, o endpoint retorna 401 —
# servidor sem chave NÃO expõe o estado por omissão.
#
# Gere uma por instalação (reaproveitar a mesma em todas transforma um
# vazamento em acesso a todas):
#   openssl rand -hex 24
#
# Hexadecimal, e não base64: só [0-9a-f] atravessa .env, URL e ODBC sem escapar.
IVR_HEALTH_CHECK_API_KEY=

